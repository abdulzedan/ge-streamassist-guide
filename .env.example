# ------------------------------------------------------------------
# Gemini Enterprise — Stream Assist API environment
# Copy to .env and fill in values for your own project:
#   cp .env.example .env
# Discover your values with: ./scripts/discover.sh
# ------------------------------------------------------------------

# GCP project that hosts the Gemini Enterprise app (project ID, not number)
export PROJECT_ID="your-project-id"

# Numeric project identifier. Native A2A URLs and data-store paths use this.
export PROJECT_NUMBER="000000000000"

# Location of the Gemini Enterprise app: global | us | eu
export LOCATION="global"

# The Gemini Enterprise app (engine) ID — find it in the console URL or
# via ./scripts/discover.sh
export APP_ID="your-app-id_0000000000000"

# Assistant ID — "default_assistant" unless you created additional assistants
export ASSISTANT_ID="default_assistant"

# Stable API for streamAssist, sessions, tools and :assist.
# Alpha-only snippets select v1alpha themselves.
export API_VERSION="v1"

# Soak fixtures. Set these only when using soak/deploy.sh.
export SOAK_A2A_AGENT_ID="your-a2a-capable-agent-id"
export SOAK_DATA_STORE_ID="your-data-store-id"
export SOAK_LICENSE_LIMIT="0"
export SOAK_LICENSE_COUNT="0"
export SOAK_LICENSE_EDITION="unconfigured"
